APP_ENV=development
LOG_LEVEL=INFO
PERSISTENCE_BACKEND=postgresql
DATABASE_URL=postgresql://church_manage:church_manage@localhost:5433/church_manage_test
AUTH_TOKEN_SECRET=replace-with-python-secrets-token-urlsafe-32-output
AUTH_COOKIE_SECURE=false
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SENDER=no-reply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
PUBLIC_APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_ALLOW_CREDENTIALS=true
ALLOWED_HOSTS=localhost,127.0.0.1
API_DOCS_ENABLED=true
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
TURNSTILE_ALLOWED_HOSTNAMES=localhost
RATE_LIMIT_VERIFY_EMAIL_LIMIT=10
RATE_LIMIT_VERIFY_EMAIL_WINDOW_SECONDS=3600
RATE_LIMIT_RESEND_EMAIL_VERIFICATION_LIMIT=5
RATE_LIMIT_RESEND_EMAIL_VERIFICATION_WINDOW_SECONDS=3600
RATE_LIMIT_FORGOT_PASSWORD_LIMIT=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
RATE_LIMIT_RESET_PASSWORD_LIMIT=10
RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REFRESH_LIMIT=20
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_CHANGE_PASSWORD_LIMIT=5
RATE_LIMIT_CHANGE_PASSWORD_WINDOW_SECONDS=3600
